#!/usr/bin/env node
"use strict";

/**
 * Module dependencies.
 */

// The first act of the process, before the heavy requires below. Node running as PID 1 IGNORES
// SIGTERM while nothing is listening for it, so a stop racing startup would be discarded outright and
// the task would serve on until ECS killed it.
var gracefulShutdown = require('@linn-cloud/graceful-shutdown');
gracefulShutdown.holdSignalsUntilInstalled();

var app = require('../app');
var debug = require('debug')('CloudExaktPopulator:server');
var http = require('http');
var log = require('../logger');
var shutdownConfig = require('../shutdownConfig');

/**
 * Get port from environment and store in Express.
 */
var port = normalizePort(process.env.PORT || '3000');
app.set('port', port);

/**
 * Create HTTP server.
 */

var server = http.createServer(app);

server.keepAliveTimeout = shutdownConfig.KEEP_ALIVE_TIMEOUT_MS;

gracefulShutdown.install(server, {
  drainTimeoutMs: shutdownConfig.DRAIN_TIMEOUT_MS,
  exitFlushTimeoutMs: shutdownConfig.EXIT_FLUSH_TIMEOUT_MS,
  log: log,
});

/**
 * Listen on provided port, on all network interfaces.
 */

server.listen(port);
server.on('error', onError);
server.on('listening', onListening);

/**
 * Normalize a port into a number, string, or false.
 */

function normalizePort(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    // named pipe
    return val;
  }

  if (port >= 0) {
    // port number
    return port;
  }

  return false;
}

/**
 * Event listener for HTTP server "error" event.
 */

function onError(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  var bind = typeof port === 'string' ? 'Pipe ' + port : 'Port ' + port;

  // handle specific listen errors with friendly messages
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      // Flushed rather than exited on directly: this is the message you need when a task will not
      // start, and it goes to a pipe that process.exit() would discard.
      gracefulShutdown.exitAfterFlushing(1, shutdownConfig.EXIT_FLUSH_TIMEOUT_MS);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      gracefulShutdown.exitAfterFlushing(1, shutdownConfig.EXIT_FLUSH_TIMEOUT_MS);
      break;
    default:
      throw error;
  }
}

/**
 * Event listener for HTTP server "listening" event.
 */

function onListening() {
  var addr = server.address();
  var bind = typeof addr === 'string' ? 'pipe ' + addr : 'port ' + addr.port;
  debug('Listening on ' + bind);
}
